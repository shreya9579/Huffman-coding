from pathlib import Path
import random
import sys

out = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).parent / 'data'
out.mkdir(parents=True, exist_ok=True)
(out / 'empty.bin').write_bytes(b'')
(out / 'single_70000.bin').write_bytes(b'A' * 70000)
pattern = b'ABACABA'
for reps, name in [(1, 'pattern_7.bin'), (1000, 'pattern_7000.bin'), (10000, 'pattern_70000.bin')]:
    (out / name).write_bytes(pattern * reps)
(out / 'uniform_65536.bin').write_bytes(bytes(range(256)) * 256)
(out / 'skewed_65536.bin').write_bytes(b'A' * 65281 + bytes(i for i in range(256) if i != ord('A')))
rng = random.Random(3358)
(out / 'random_65536.bin').write_bytes(rng.randbytes(65536))
text = (b'Lossless compression stores repeated patterns efficiently. Huffman coding assigns shorter codes to common bytes and longer codes to rare bytes. ')
(out / 'text_65536.bin').write_bytes((text * ((65536 + len(text) - 1) // len(text)))[:65536])
print(f'Generated datasets in {out.resolve()}')
